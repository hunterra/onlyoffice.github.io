{
    "name": "luluaddress plugin",
    "description": "luluaddress plugin",
    "version": "1.0",
    "manifest_version": 3,
    "web_accessible_resources": [{
        "resources": [
          "/main.js",
          "/inject.js"
        ],
      "matches": [ "<all_urls>" ]
    }],
    "icons": {
        "48": "icons/icon@1.75x.png"
    },
    "content_scripts": [
    {
        "match_about_blank" : true,
        "all_frames" : true,
        "matches": ["<all_urls>"],
        "js": [ "/main.js" ],
        "run_at": "document_end"
    }
    ],
    "permissions": [
        "storage", 
        "tabs", 
        "declarativeContent", 
        "activeTab", 
        "scripting"
    ],
    "host_permissions": [
        "*://*/*",
        "<all_urls>"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}